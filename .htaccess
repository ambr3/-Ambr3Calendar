# Security headers for Ambr3Calendar (Apache, requires mod_headers: `a2enmod headers`).
# If you host elsewhere instead:
#   - Netlify: use a `_headers` file
#   - nginx: add an `add_header` block in your server config
# The <meta http-equiv="Content-Security-Policy"> in index.html remains as a fallback
# for hosts that ignore .htaccess; when a server sends a CSP header it takes precedence.

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "no-referrer"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), clipboard-read=(), clipboard-write=(), usb=(), midi=(), serial=(), display-capture=(), accelerometer=(), gyroscope=(), magnetometer=(), idle-detection=(), screen-wake-lock=()"

  # CSP is enforced only as an HTTP header; `frame-ancestors` is ignored in <meta>.
  <FilesMatch "^index\.html$">
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'"
  </FilesMatch>
</IfModule>
